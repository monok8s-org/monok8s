# aspect_rules_js 3.x exposes `npm_link_all_packages` from the
# `@npm` repo generated by `npm.npm_translate_lock(name = "npm", ...)`
# in MODULE.bazel — NOT from `@aspect_rules_js//npm:defs.bzl` like
# 2.x did. Loading from the wrong path was the carryover from the
# pre-#51 scaffolding and showed up as "file '@aspect_rules_js//npm:
# defs.bzl' does not contain symbol 'npm_link_all_packages'" on every
# `bazel build //...` until this fix.
load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

# Expose root jest config to all packages
exports_files([
    "jest.config.js",
    "babel.config.js",
    "tsconfig.json",
    # #193 — jest_version_unification_test in //frontend reads this
    # to assert the jest-family pins share a single semver major.
    "package.json",
])

# Shared TypeScript config target. ts_project's `tsconfig` attribute needs
# a target (not a file) when the config lives outside the consuming
# package — the rule copies the tsconfig to the package's bin dir, which
# fails for raw cross-package file refs. ts_config wraps the file at the
# root so subpackages can reference it as `tsconfig = "//:tsconfig"`.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)

# jest_test requires its `config` to live in the consuming package's
# Bazel package. copy_to_bin produces a copy in //:__pkg__ that other
# packages can reference via `config = "//:jest_config"`; aspect_rules_jest's
# copy_file_to_bin_action then re-copies into the consuming package's bin
# dir at action time.
copy_to_bin(
    name = "jest_config",
    srcs = ["jest.config.js"],
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "babel_config",
    srcs = ["babel.config.js"],
    visibility = ["//visibility:public"],
)

