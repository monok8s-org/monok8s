# v0.3.0's own MODULE.bazel calls `kubernetes.version(versions = ["1.29"])`
# at module-level, so consumers DON'T need to repeat the tag — just
# `use_extension` + `use_repo` picks up the auto-registered hermetic
# repos. Eliminates the established CI-failure signature on GitHub
# runners (which don't ship kube-apiserver). Per
# collider-bazel-extensions/rules_kubernetes#2.
kubernetes = use_extension("@rules_kubernetes//:extensions.bzl", "kubernetes")
use_repo(kubernetes, "k8s_1_29_darwin_amd64", "k8s_1_29_darwin_arm64", "k8s_1_29_linux_amd64")

