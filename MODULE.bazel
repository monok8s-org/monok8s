)

# npm dependencies — pnpm-locked, hermetically resolved by aspect_rules_js.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# TypeScript toolchain for aspect_rules_ts. The `ts_project` rule
# resolves its compiler via the `@npm_typescript` repo this extension
# generates; without it consumers see "no such package
# '@@npm_typescript'" at analysis time.
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps()
use_repo(rules_ts_ext, "npm_typescript")

# Postgres for hermetic DB tests. rules_pg v0.4.0 added a
# `pg.version()` tag class that fetches a hermetic conda-forge
# Postgres closure — replaces the prior implicit `pg.system()` mode
# that required `pg_ctl` to already be on the host. Eliminates the
# established CI-failure signature on GitHub runners (which don't
# ship postgres-server-dev). Per collider-bazel-extensions/rules_pg#2.
pg = use_extension("@rules_pg//:extensions.bzl", "pg")
pg.version(versions = ["16"])
use_repo(pg, "pg_16_darwin_amd64", "pg_16_darwin_arm64", "pg_16_linux_amd64")

# Temporal for hermetic workflow tests. rules_temporal v0.5.0's own
# MODULE.bazel calls `temporal.version(versions = ["1.7.0"])` at
# module-level (mirrors rules_kubernetes v0.3.0's pattern), so
# consumers DON'T need to repeat the tag — just `use_extension` +
# `use_repo` picks up the auto-registered hermetic repos. Per
# collider-bazel-extensions/rules_temporal#6. Resolves the final
# `rules_X.system() not found in PATH` CI signature.
temporal = use_extension("@rules_temporal//:extensions.bzl", "temporal")
use_repo(temporal, "temporal_1_7_0_darwin_amd64", "temporal_1_7_0_darwin_arm64", "temporal_1_7_0_linux_amd64")

# NATS for the live event bus (#78) and future hermetic pub/sub tests. The
# extension is `mod.is_root`-guarded (same shape as rules_capsule /
# rules_temporal / rules_atlas), so consumers wire the version themselves.
# nats_install (cluster-deploy) uses the in-rule manifest label directly
# and does not depend on the binary toolchains below — those are wired now
# so future nats_server / nats_test fixtures land without re-editing here.
nats = use_extension("@rules_nats//:extensions.bzl", "nats")
nats.version(
    cli_version = "0.4.0",
    version = "2.14.0",
)
use_repo(
    nats,
    "nats_2_14_0_darwin_amd64",
    "nats_2_14_0_darwin_arm64",
    "nats_2_14_0_linux_amd64",
    "nats_2_14_0_linux_arm64",
)

register_toolchains("@rules_nats//toolchain:all")

