use_repo(capsule, "capsule")

register_toolchains("@capsule//:all")

# Cilium install toolchain (for #19's L4 follow-up + the bundled manifest
# we vendor at platform/cilium/bootstrap.yaml).
cilium = use_extension("@rules_cilium//:extensions.bzl", "cilium")
cilium.version(
    name = "cilium",
    version = "1.16.5",
)
use_repo(cilium, "cilium")

register_toolchains("@cilium//:all")

# cert-manager install toolchain (for #24's temporal-operator webhook
# TLS + #17's Capsule webhook TLS + future workloads). Pair-bumped with
# the manifest we vendor at platform/cert-manager/bootstrap.yaml.
cert_manager = use_extension("@rules_certmanager//:extensions.bzl", "cert_manager")
cert_manager.version(
    name = "cert_manager",
    version = "1.18.3",
)
use_repo(cert_manager, "cert_manager")

register_toolchains("@cert_manager//:all")

# OPA CLI toolchain (for opa_test + opa_fmt_check). Used by the
# require-tenant-label rego policy unit test.
opa = use_extension("@rules_opa//:extensions.bzl", "opa")
opa.version(version = "1.15.2")
use_repo(
    opa,
    "opa_darwin_amd64",
    "opa_darwin_arm64",
    "opa_linux_amd64",
)

register_toolchains("@rules_opa//toolchain:all")

# Crossplane CLI toolchain (for crossplane_render_test). Multi-platform
# crank binary downloaded from releases.crossplane.io and sha256-pinned
# inside rules_crossplane's extensions; consumers just use_repo + register.
crossplane = use_extension("@rules_crossplane//:extensions.bzl", "crossplane")
crossplane.version(version = "v2.2.1")
use_repo(
    crossplane,
    "crank_v2_2_1_darwin_amd64",
    "crank_v2_2_1_darwin_arm64",
    "crank_v2_2_1_linux_amd64",
    "crank_v2_2_1_linux_arm64",
)

register_toolchains(
    "@crank_v2_2_1_darwin_amd64//:toolchain",
    "@crank_v2_2_1_darwin_arm64//:toolchain",
    "@crank_v2_2_1_linux_amd64//:toolchain",
    "@crank_v2_2_1_linux_arm64//:toolchain",
)
