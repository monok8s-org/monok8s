# rules_atlas's `atlas` extension is `mod.is_root`-guarded (avoids
# duplicate-repo collisions when consumed transitively); consumers
# declare the wiring themselves — same shape rules_capsule /
# rules_temporal use. v0.3.0 fixed the README to document this.
atlas = use_extension("@rules_atlas//:extensions.bzl", "atlas")
atlas.version(version = "1.2.0")
use_repo(
    atlas,
    "atlas_darwin_amd64",
    "atlas_darwin_arm64",
    "atlas_linux_amd64",
    "atlas_linux_arm64",
)

register_toolchains("@rules_atlas//toolchain:all")

# Transitive dep of rules_crossplane. rules_crossplane's own MODULE.bazel
# uses a git_override against this version, but bzlmod only honors
# overrides from the root module — so we re-declare it here.
bazel_dep(name = "rules_kubectl", version = "0.2.0")
archive_override(
    module_name = "rules_kubectl",
    integrity = "sha256-mXeULtsLScwapCoCTvz3joQkmNJ686aDCOliOCXt0zo=",
