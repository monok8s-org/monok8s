# Copy to .env.local and fill in any blanks.
# .env.local is gitignored — never commit real secrets.
# In full mode (Tilt), these are injected from Vault via ExternalSecret.

# Server
PORT=3000

# Database (direct connection — no PgBouncer in fast mode)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monok8s

# Zitadel (AuthN)
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=local-dev

# SpiceDB (AuthZ)
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=dev-preshared-key
SPICEDB_INSECURE=true

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Feature flags (flagd)
FLAGD_HOST=localhost
FLAGD_PORT=8013

# OpenMeter
OPENMETER_ENDPOINT=http://localhost:8888

# OpenTelemetry (disabled in fast mode — enable to test traces locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=api
