# ── L2 itest: events.audit SSE delivery + audit_log row insert (#179 / #88c) ──
# Two backends: pg (audit_log INSERT via the production emitter) +
# nats (audit envelope publish + SSE-fanout subscription). Migration
# 008 ships with the test as a runfile; the launcher passes the path
# via MONOK8S_AUDIT_LOG_SQL so the test driver applies the DDL at
# startup (separate from packages/db's :schema target which only
# includes 001+002 today per Gap 19).

nats_server(
    name = "audit_events_nats",
    tags = ["manual"],
)

postgres_schema(
    name = "_audit_l2_empty_schema",
    srcs = [],
)

pg_server(
    name = "audit_pg",
    schema = ":_audit_l2_empty_schema",
    tags = ["manual"],
)

ts_project(
    name = "events_audit_l2_test_lib",
    srcs = ["test/events_audit_l2_test.ts"],
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        "//:node_modules/@trpc/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/@types/node",
        "//:node_modules/@types/pg",
        "//:node_modules/nats",
        "//:node_modules/pg",
        "//packages/auth:lib",
        "//packages/db:lib",
        "//packages/trpc:lib",
    ],
)

sh_binary(
    name = "events_audit_l2_test_sh",
    srcs = ["test/events_audit_l2_test.sh"],
    data = [
        ":events_audit_l2_test_lib",
        ":lib",
        "//:node_modules/@trpc/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/nats",
        "//:node_modules/pg",
        "//packages/auth:lib",
        "//packages/db:audit_log_migration",
        "//packages/db:lib",
        "//packages/trpc:lib",
        "//tools/bazel:monok8s_esm_loader",
    ],
    tags = ["manual"],
)

itest_suite(
    name = "events_audit_l2_test",
    servers = {
        "nats": ":audit_events_nats",
        "pg": ":audit_pg",
    },
    tags = [
        "impure",
        "nats",
        "pg",
    ],
    test = ":events_audit_l2_test_sh",
)

js_binary(
    name = "bin",
    # aspect_rules_js's js_binary takes the compiled artifacts via
    # `data` (runfiles), not `deps` (which doesn't exist on this rule
    # in v3.x). The `:lib` target's ts_project output is the
    # JavaScript runfiles that the entry_point references.
    data = [":lib"],
    entry_point = "src/index.js",
)

app_image(
    name = "image",
    binary = ":bin",
    language = "node",
    description = "monok8s API service",
)
