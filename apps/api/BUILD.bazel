# ── L2 itest: tenant.events SSE delivery within 1s (#88a AC) ─────────
# Re-introduced via #178 once the cross-package ESM resolution gap
# (Discussion #45 Gap 25) was closed by tools/bazel/monok8s-esm-loader.mjs
# plus the project-wide `.js`-extension hygiene sweep.

nats_server(
    name = "events_nats",
    tags = ["manual"],
)

ts_project(
    name = "events_l2_test_lib",
    srcs = ["test/events_l2_test.ts"],
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        "//:node_modules/@trpc/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/@types/node",
        "//:node_modules/nats",
        "//packages/auth:lib",
        "//packages/db:lib",
        "//packages/trpc:lib",
    ],
)

sh_binary(
    name = "events_l2_test_sh",
    srcs = ["test/events_l2_test.sh"],
    data = [
        ":events_l2_test_lib",
        ":lib",
        "//:node_modules/@trpc/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/nats",
        "//packages/auth:lib",
        "//packages/db:lib",
        "//packages/trpc:lib",
        "//tools/bazel:monok8s_esm_loader",
    ],
    tags = ["manual"],
)

itest_suite(
    name = "events_l2_test",
    servers = {"nats": ":events_nats"},
    tags = ["impure"],
    test = ":events_l2_test_sh",
)

