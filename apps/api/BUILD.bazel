# Routers under src/routers/{installations,marketplace}.ts are scaffolded
# ahead of their owning Issues (#87 principal mutation procedures,
# #90 CLI scaffold). They reference context fields (`ctx.temporal`,
# `ctx.gcpMarketplaceTokenVerified`, etc.) that don't exist on the
# Context shape until those Issues land. The auth middleware (#89) now
# lives in //packages/auth as middleware.ts; apps/api consumes it via
# @monok8s/auth. system.ts stays in (no @monok8s/* dep).
ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/routers/installations.ts",
            "src/routers/marketplace.ts",
        ],
    ),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        "//:node_modules/@temporalio/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/@types/node",
        "//:node_modules/@types/pg",
        "//:node_modules/nats",
        "//:node_modules/pg",
        "//:node_modules/zod",
        "//packages/auth:lib",
        "//packages/db:lib",
        "//packages/trpc:lib",
    ],
)

# Compiled test sources — separated from :lib so production builds
# don't pull in @jest/globals transitively.
ts_project(
    name = "lib_test",
    srcs = glob(["src/**/*.test.ts"]),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        "//:node_modules/@jest/globals",
        "//:node_modules/@temporalio/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/@types/jest",
        "//:node_modules/@types/node",
        "//:node_modules/jest",
        "//:node_modules/nats",
        "//:node_modules/zod",
        "//packages/auth:lib",
        "//packages/db:lib",
        "//packages/trpc:lib",
    ],
)

