load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:oci.bzl", "app_image")

go_library(
    name = "cli_lib",
    srcs = ["main.go"],
    importpath = "github.com/monok8s/monok8s/apps/cli",
    deps = [
        "//apps/cli/cmd",
        "//apps/cli/internal/client",
        "//apps/cli/internal/output",
        "@com_github_spf13_cobra//:cobra",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_binary(
    name = "cli",
    embed = [":cli_lib"],
)

app_image(
    name = "image",
    binary = ":cli",
    language = "go",
    description = "monok8s CLI",
)
