load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:oci.bzl", "app_image")

go_library(
    name = "telemetry_gateway_lib",
    srcs = ["main.go"],
    importpath = "github.com/monok8s/monok8s/apps/telemetry-gateway",
)

go_binary(
    name = "telemetry-gateway",
    embed = [":telemetry_gateway_lib"],
)

app_image(
    name = "image",
    binary = ":telemetry-gateway",
    language = "go",
    description = "monok8s telemetry gateway (mTLS reverse proxy)",
)
