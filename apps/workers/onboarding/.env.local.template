# Copy to .env.local and fill in any blanks.
# .env.local is gitignored — never commit real secrets.

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=onboarding

# Database (for activities)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monok8s

# Vault (optional in fast mode — activities read from env directly)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root

# SpiceDB
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=dev-preshared-key
SPICEDB_INSECURE=true

# Zitadel admin
ZITADEL_ENDPOINT=http://localhost:8080

# OpenMeter
OPENMETER_ENDPOINT=http://localhost:8888

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=onboarding-worker
