# Temporal worker library + binary for the `onboarding` task queue.
# Monolithic `package main` per Go convention — workflows, activities,
# and the entrypoint all co-located in this directory.
#
# Activities are stub-error today (per #84 PR-A); real Crossplane /
# Argo / NATS integration lands in #124 sub-PRs 2-4 alongside the
# L2 itest_suite + recorded-history replay_test in sub-PR-5 (via the
# upstream rules_temporal `temporal_test` + `temporal_workflow_history`
# primitives).
#
# //packages/db is intentionally NOT a dep — the original scaffolding
# pre-declared it but no activity actually imports packages/db (and
# the `:db` target alias doesn't exist; tracked in Discussion #45
# Gap 1 as a separate blocker). Wired back when a real activity needs
# DB access in sub-PR-3.
go_library(
    name = "onboarding",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/monok8s/monok8s/apps/workers/onboarding",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_nats_io_nats_go//:nats_go",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_client_go//dynamic",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "//packages/auth:auth",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_sdk//activity",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//worker",
        "@io_temporal_go_sdk//workflow",
    ],
)

# Binary entrypoint. The library is `package main` per the apps/cli
# convention (single-directory binary, no cmd/ subdir).
go_binary(
    name = "worker",
    embed = [":onboarding"],
)

# Workflow-history replay-runner binary. Shares srcs with the
# production worker via embed=[":onboarding"], but the `replay_runner`
# go-build tag swaps `main.go`'s production main() out for
# `replay_runner_main.go`'s replayer-driven main(). Per
# rules_temporal v0.4.0's custom_replay_runner mechanism. Consumed
# by the temporal_build :worker_build target below.
go_binary(
    name = "replay_runner_bin",
    embed = [":onboarding"],
    gotags = ["replay_runner"],
)

# OCI image — distroless_static base via tools/bazel/oci.bzl's
# `app_image(language="go", ...)`. Non-functional in production until
# sub-PRs 2-4 ship real activity implementations; the image build
# itself is hermetic.
app_image(
    name = "image",
    binary = ":worker",
    language = "go",
    description = "monok8s onboarding worker",
)

