# ── L2 itest_suite for OnboardTenantWorkflow (#129c) ────────────────────
#
# 3-server hermetic environment (k8s + nats + temporal) running the
# production :worker subprocess against simulated controllers (the
# driver_test.go's 2 sidecar Watch goroutines fake Crossplane reconcile
# and Argo Workflows onExit). Captures workflow history JSON to
# $TEST_UNDECLARED_OUTPUTS_DIR which the operator extracts + commits
# to testdata/histories/ to close #129b's replay-test Gap.

# Manifest aggregation pre-applied via kubernetes_manifest →
# kubernetes_server's kubectl-apply step:
#   - Crossplane meta-CRDs (compositeresourcedefinitions, compositions)
#     so the XTenant + XTenantDatabase XRDs admit cleanly.
#   - XTenant + XTenantDatabase XRDs — the CR kinds activities_xr.go
#     submits.
#   - argoproj.io Workflow CRD — the CR kind activities_argo.go
#     submits. Minimal local vendoring; see the CRD file's header for
#     why we don't slice from platform/argo-workflows/bootstrap.yaml.
#   - argo Namespace — activities_argo.go hardcodes this namespace.
kubernetes_manifest(
    name = "itest_manifests",
    srcs = [
        # Minimal plain CRDs for the XR kinds + Argo Workflow kind.
        # Crossplane XRDs at //infra/crossplane/xrds/ register API
        # kinds only when the Crossplane controller is reconciling
        # them; in this envtest's bare apiserver+etcd, an XRD is just
        # data in etcd. Plain CRDs registered directly here let
        # dynamic.Interface.Create(xtenantGVR) succeed; the driver's
        # sidecar simulates Crossplane reconcile by patching
        # status.ready=true.
        "testdata/itest/crds/workflows.argoproj.io.yaml",
        "testdata/itest/crds/xtenantdatabases.monok8s.io.yaml",
        "testdata/itest/crds/xtenants.monok8s.io.yaml",
        "testdata/itest/manifests/argo-namespace.yaml",
    ],
)

kubernetes_server(
    name = "itest_k8s",
    manifests = ":itest_manifests",
)

nats_server(
    name = "itest_nats",
)

temporal_server(
    name = "itest_temporal",
)

# Go test driver. Tagged `manual` because the itest_suite wrapper is
# the public entry point — running this directly skips the server
# orchestration. The driver spawns the :worker binary as a subprocess
# (data dep) and runs the 2 sidecar Watch goroutines in-process.
go_test(
    name = "workflow_itest_driver",
    srcs = ["itest/driver_test.go"],
    data = [":worker"],
    # `impure` for the test_purity_tagging code-design rule (the
    # driver binds loopback sockets via the spawned :worker subprocess
    # + sidecar Watch connections). `manual` because the itest_suite
    # wrapper is the public entry point.
    tags = [
        "impure",
        "manual",
    ],
    deps = [
        "@com_github_nats_io_nats_go//:nats_go",
        "@rules_go//go/runfiles",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_apimachinery//pkg/watch",
        "@io_k8s_client_go//dynamic",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_sdk//client",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

# Public target. Brings up k8s+nats+temporal; exec's the Go driver.
# Tagged `impure` per the established convention for L2 envtests.
itest_suite(
    name = "workflow_itest",
    servers = {
        "k8s": ":itest_k8s",
        "nats": ":itest_nats",
        "temporal": ":itest_temporal",
    },
    tags = ["impure"],
    test = ":workflow_itest_driver",
)

# Recorded histories for the replay_test. The 649-event JSON at
# testdata/histories/onboard_tenant_happy.json was captured by
# #129c's L2 test driver via client.GetWorkflowHistory + protojson.
temporal_workflow_history(
    name = "histories",
    srcs = glob(["testdata/histories/*.json"]),
    worker = ":worker_build",
)

# Recorded-history replay test. temporal_test's launcher boots a
# transient `temporal server start-dev`, starts the :worker binary,
# validates the running pollers match worker_build's declarations,
# replays every committed history via the custom_replay_runner
# (`:replay_runner_bin` — a Go binary using worker.WorkflowReplayer),
# then exec's the no-op test body. Non-determinism in the workflow
# code fails the target.
#
# Closes #129b's long-standing Gap (history replay actually running)
# per rules_temporal v0.4.0's per-language-runner support.
#
# Naming convention per tools/bazel/CLAUDE.md ("Temporal replay test
# targets are always named `replay_test`"). Tagged `impure` because
# the launcher binds a loopback port for the dev server.
temporal_test(
    name = "replay_test",
    srcs = ["replay_only.sh"],
    history = ":histories",
    tags = ["impure"],
    worker = ":worker_build",
)
