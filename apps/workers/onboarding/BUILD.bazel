# Temporal worker registration manifest (#129b). Lists every workflow
# + activity the :worker binary registers at runtime so the launcher
# below can validate the running worker's pollers match declarations.
# Source of truth: run.go's w.RegisterWorkflow / w.RegisterActivity
# calls (lines 43-93). Temporal registers activities by Go function
# name (no RegisterActivityWithOptions overrides in run.go), so each
# function name maps 1:1 to the declared activity type name.
#
# `replay_runner` attribute (per rules_temporal v0.4.0) supplies the
# Go replay runner that `temporal_test`'s launcher invokes for each
# committed history JSON. Shares onboarding's package main srcs via
# the `replay_runner` go-build tag.
temporal_build(
    name = "worker_build",
    replay_runner = ":replay_runner_bin",
    activity_types = [
        # Workflow status emit (#177 / #88b):
        "EmitWorkflowStatusActivity",
        # OnboardTenantWorkflow forward path (#84):
        "ProvisionNamespaceActivity",
        "ProvisionDatabaseActivity",
        "MintTenantVaultKeyActivity",
        "RunMigrationsActivity",
        "EmitTenantCreatedEventActivity",
        # OnboardTenantWorkflow compensation cleanup (#129a):
        "DeleteTenantNamespaceActivity",
        "DeleteTenantDatabaseActivity",
        "DeleteTenantVaultKeyActivity",
        "EmitTenantCreationFailedEventActivity",
        # Legacy tenant-onboarding scaffolding (run.go):
        "CreateZitadelOrgActivity",
        "WritePermissionsActivity",
        "RegisterMeteringActivity",
        # RegisterUserWorkflow + ErasureWorkflow:
        "ProvisionVaultKeyActivity",
        "WritePIIActivity",
        "WriteUserEventActivity",
        "WriteUserSpiceDBActivity",
        "WriteMemberSpiceDBActivity",
        "WriteMemberEventActivity",
        "WriteUserDeletedEventActivity",
        "DeleteVaultKeyActivity",
        "DeletePIIRowActivity",
        "RevokeZitadelUserActivity",
        "RemoveUserSpiceDBActivity",
        # TemporaryGrantWorkflow:
        "RemoveGrantSpiceDBActivity",
        "UpdateGrantStatusActivity",
        # InstallationRegistration / HeartbeatMonitor / Revocation:
        "ValidateBootstrapTokenActivity",
        "IssueInstallationCertActivity",
        "GenerateInstallationAPIKeyActivity",
        "WriteInstallationSpiceDBActivity",
        "ActivateInstallationActivity",
        "UpdateInstallationHeartbeatActivity",
        "FireInstallationAlertActivity",
        "SignalHeartbeatMonitorActivity",
        "RevokeInstallationCertActivity",
        "RevokeInstallationSpiceDBActivity",
        "MarkInstallationRevokedActivity",
        # TenantRoleAssign/UnassignWorkflows (#232 — PR-1 of roles.assign chain):
        "AssignTenantRoleSpiceDBActivity",
        "UnassignTenantRoleSpiceDBActivity",
        # TenantRoleChangeWorkflow (#236):
        "ChangeTenantRoleSpiceDBActivity",
        # TenantGroupMember Add/Remove workflows (#248):
        "AddGroupMemberSpiceDBActivity",
        "RemoveGroupMemberSpiceDBActivity",
        # TenantUserSuspend/Reinstate workflows (#252):
        "SuspendMemberSpiceDBActivity",
        "ReinstateMemberSpiceDBActivity",
