{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "new-dashboard": {
      "state": "ENABLED",
      "variants": {
        "on": true,
        "off": false
      },
      "defaultVariant": "off",
      "targeting": {
        "if": [
          { "in": [{ "var": "tenantPlan" }, ["pro", "enterprise"]] },
          "on",
          "off"
        ]
      }
    },
    "billing-v2": {
      "state": "ENABLED",
      "variants": {
        "on": true,
        "off": false
      },
      "defaultVariant": "off"
    }
  }
}
