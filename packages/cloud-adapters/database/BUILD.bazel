"""Cloud-adapter database axis (#80, #104) — TS + Go libraries + contract tests.

Go: real bare-metal CNPG impl (#104). Talks directly to the K8s API
over HTTP — no client-go dep needed. Applies a CNPG `Cluster` CR per
tenant; returns a Handle with the canonical
`<cluster>-rw.<ns>.svc.cluster.local` DSN (password omitted, fetched
separately from the CNPG-generated `<cluster>-app` Secret). Contract
test spawns an in-process httptest fake K8s API.

TS: same fetch-based shape. Jest contract test stubs fetch and asserts
URL/verb/body/auth shape.
"""

load("@aspect_rules_jest//jest:defs.bzl", "jest_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# ── TypeScript ──────────────────────────────────────────────────────────

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["*.ts"],
        exclude = ["*.test.ts"],
    ),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@types/node",
    ],
)

ts_project(
    name = "lib_test",
    srcs = glob(["*.test.ts"]),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/jest",
        "//:node_modules/@types/node",
        "//:node_modules/jest",
    ],
)

jest_test(
    name = "contract_test",
    config = "//:jest_config",
    data = [
        ":lib",
        ":lib_test",
        "//:babel_config",
        "//:node_modules/@babel/core",
        "//:node_modules/@babel/preset-env",
        "//:node_modules/@babel/preset-typescript",
        "//:node_modules/babel-jest",
        "//:node_modules/babel-preset-solid",
        "//:node_modules/jest-environment-jsdom",
    ],
    node_modules = "//:node_modules",
    tags = ["impure"],
)

# ── Go ──────────────────────────────────────────────────────────────────

go_library(
    name = "database",
    srcs = [
        "aws.go",
        "azure.go",
        "baremetal.go",
        "gcp.go",
        "interface.go",
    ],
    importpath = "github.com/monok8s/monok8s/packages/cloud-adapters/database",
    visibility = ["//visibility:public"],
)

go_test(
    name = "database_test",
    srcs = ["baremetal_test.go"],
    embed = [":database"],
    tags = ["impure"],
)
