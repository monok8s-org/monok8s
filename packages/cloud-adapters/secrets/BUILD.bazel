"""Cloud-adapter secrets axis (#80, #103) — TS + Go libraries + contract tests.

Go: real bare-metal Vault Transit impl (#103) wrapping the canonical
`github.com/hashicorp/vault/api` client. Contract test spawns an
in-process `httptest.Server` faking the Transit endpoints
(mint/encrypt/decrypt/rotate/delete + deletion-config) — hermetic L1,
no host binaries. Includes an explicit crypto-shred assertion.

TS: real bare-metal Vault Transit impl via direct fetch against the
Vault HTTP API + jest_test runtime wiring contract (mirrors the #110
pattern). The Go contract test does the deeper crypto-shred round-trip;
the TS-side jest test asserts the wiring shape against a stubbed fetch.
"""

load("@aspect_rules_jest//jest:defs.bzl", "jest_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# ── TypeScript ──────────────────────────────────────────────────────────

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["*.ts"],
        exclude = ["*.test.ts"],
    ),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@types/node",
    ],
)

ts_project(
    name = "lib_test",
    srcs = glob(["*.test.ts"]),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/jest",
        "//:node_modules/@types/node",
        "//:node_modules/jest",
    ],
)

jest_test(
    name = "contract_test",
    config = "//:jest_config",
    data = [
        ":lib",
        ":lib_test",
        "//:babel_config",
        "//:node_modules/@babel/core",
        "//:node_modules/@babel/preset-env",
        "//:node_modules/@babel/preset-typescript",
        "//:node_modules/babel-jest",
        "//:node_modules/babel-preset-solid",
        "//:node_modules/jest-environment-jsdom",
    ],
    node_modules = "//:node_modules",
    tags = ["impure"],
)

# ── Go ──────────────────────────────────────────────────────────────────

go_library(
    name = "secrets",
    srcs = [
        "aws.go",
        "azure.go",
        "baremetal.go",
        "gcp.go",
        "interface.go",
    ],
    importpath = "github.com/monok8s/monok8s/packages/cloud-adapters/secrets",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_hashicorp_vault_api//:api",
    ],
)

go_test(
    name = "secrets_test",
    srcs = ["baremetal_test.go"],
    embed = [":secrets"],
    tags = ["impure"],
    deps = [
        "@com_github_hashicorp_vault_api//:api",
    ],
)
