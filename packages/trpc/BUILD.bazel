"""packages/trpc — shared tRPC router init + Context (#36) + client
factory (#192 / #91 Phase C).

Sub-claim of #36 — full L3 ACs (frontend type-import end-to-end) remain on
the parent Issue. This BUILD landed as part of the bootstrap-split that
unblocks #79.
"""

load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_jest//jest:defs.bzl", "jest_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/**/*.test.ts"],
    ),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@trpc/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/@types/node",
    ],
)

ts_project(
    name = "lib_test",
    srcs = glob(["src/**/*.test.ts"]),
    declaration = True,
    preserve_jsx = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        "//:node_modules/@jest/globals",
        "//:node_modules/@trpc/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/@types/jest",
        "//:node_modules/@types/node",
        "//:node_modules/jest",
    ],
)

copy_to_bin(
    name = "jest_config",
    srcs = ["jest.config.js"],
)

# Workspace package — pnpm-workspace.yaml + the root package.json's
# `@monok8s/trpc: workspace:*` dep link `node_modules/@monok8s/trpc` to
# this directory. aspect_rules_js expects each workspace package to
# expose an `npm_package` target named `pkg` so npm_link_all_packages
# can find the linkable artifact. Lets esbuild + jest + ts resolve
# `@monok8s/trpc` + `@monok8s/trpc/client` across the repo (#192 /
# #91 Phase C).
npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# L1 unit tests for the tRPC client factory. Pure: smoke-constructs
# against injected fetch + EventSource stubs.
jest_test(
    name = "client_unit_test",
    config = ":jest_config",
    data = [
        ":lib",
        ":lib_test",
        "//:babel_config",
        "//:node_modules/@babel/core",
        "//:node_modules/@babel/preset-env",
        "//:node_modules/@babel/preset-typescript",
        "//:node_modules/@trpc/client",
        "//:node_modules/@trpc/server",
        "//:node_modules/babel-jest",
    ],
    node_modules = "//:node_modules",
    tags = ["pure"],
)
